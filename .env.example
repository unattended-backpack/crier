# The Discord webhook URL where events will be forwarded.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# The GitHub webhook secret for signature verification (optional).
GITHUB_WEBHOOK_SECRET=example_secret

# Server bind address (optional, defaults to 0.0.0.0:3000).
BIND_ADDRESS=0.0.0.0:3000

# Logging level (optional, defaults to info).
RUST_LOG=crier=info
